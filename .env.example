# =============================================================================
# RetroBook — variaveis de ambiente
# =============================================================================
# Este arquivo contem apenas NOMES e valores de exemplo. Nunca coloque
# segredos reais aqui: ele e versionado. Copie para apps/api/.env (ignorado
# pelo git) e preencha localmente.
# =============================================================================

# --- API (apps/api/.env) -----------------------------------------------------

# String de conexao do PostgreSQL.
# Local: o banco embutido (PGlite) sobe em 5433 via `npm start`.
# Producao: fornecida pelo provedor. Exige SSL — normalmente ?sslmode=require
DATABASE_URL="postgresql://retrobook:retrobook@localhost:5433/retrobook?schema=public"

# Segredos de assinatura dos tokens. PRECISAM ser diferentes entre si e ter
# 32+ caracteres em producao (a API se recusa a subir com os de exemplo).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET="troque-este-segredo-em-producao-access"
JWT_REFRESH_SECRET="troque-este-segredo-em-producao-refresh"

PORT=4000
NODE_ENV=development

# Origens autorizadas no CORS, separadas por virgula. Nunca "*": a API responde
# com credenciais, e curinga permitiria requisicao autenticada de outro site.
WEB_ORIGIN="http://localhost:5173"

# Regex ancorado para liberar os deploys de preview, que ganham dominio novo a
# cada branch. Opcional. Ex.: ^https://retrobook-[a-z0-9-]+\.vercel\.app$
VERCEL_PREVIEW_PATTERN=""

# SameSite dos cookies de sessao.
#   lax  -> site e API na mesma origem (padrao, e mais seguro)
#   none -> API em dominio proprio; forca Secure automaticamente
COOKIE_SAMESITE="lax"

# Provedor de livros: "local" (catalogo semeado) ou "google"
BOOK_PROVIDER="local"
GOOGLE_BOOKS_API_KEY=""

# --- WEB (apps/web/.env) -----------------------------------------------------

# Origem da API quando ela NAO estiver no mesmo dominio do site.
# Vazio = mesma origem (/api), servido por proxy no dev e por rewrite em prod.
# Ex.: https://retrobook-api.onrender.com/api
VITE_API_URL=""

# URL canonica publica, usada nas tags de SEO.
VITE_PUBLIC_URL=""
